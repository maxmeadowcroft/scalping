# Copy to `.env` in the project root (never commit `.env`).
# Required for real purchases: ./scraping/run_bot.sh --place-order

# --- Card (required for --place-order) ---
# If the card is already saved on your Target account, set USE_SAVED_CARD=true
# and you mainly need CARD_CVV (Target often re-asks for it at checkout).
USE_SAVED_CARD=true
CARD_CVV=123
CARD_NUMBER=4111111111111111
CARD_HOLDER_NAME=Maximus Lastname
CARD_EXPIRATION_DATE=12/28
# Full year also works (11/2030) — Target's field is MM/YY so we convert automatically.
CARD_TYPE=visa

# --- Contact / shipping (recommended; overrides configuration.json) ---
SHIPPING_NAME=Maximus Lastname
SHIPPING_PHONE=5055551234
SHIPPING_STREET=3604 Garcia St NE
SHIPPING_STREET2=
SHIPPING_CITY=Albuquerque
SHIPPING_STATE=NM
SHIPPING_ZIP=87111

# --- Billing (used when adding a new card; defaults to shipping if blank) ---
BILLING_STREET=
BILLING_STREET2=
BILLING_CITY=
BILLING_STATE=
BILLING_ZIP=
BILLING_PHONE=

# --- Checkout step-up auth ---
# Target emails a one-time code when you click Check out.
# Preferred: auto-read it from Gmail with an App Password
# https://myaccount.google.com/apppasswords
GMAIL_LOGIN=
GMAIL_APP_PASSWORD=

# Fallback: paste the code here while the bot waits
TARGET_OTP=
CHECKOUT_AUTH_TIMEOUT_SECONDS=300

# --- Round1 / Shortstack Turnstile solver (pick one) ---
# CapSolver: https://www.capsolver.com/ — preferred
CAPSOLVER_API_KEY=
# 2Captcha fallback: https://2captcha.com/
TWOCAPTCHA_API_KEY=
# Optional override: capsolver | twocaptcha (default in config: capsolver)
ROUND1_SOLVER=capsolver
